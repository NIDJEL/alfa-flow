    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.541.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hook-form": "7.62.0",
    "react-router-dom": "7.18.4",
    "recharts": "3.1.2",
    "swagger-ui-dist": "5.34.0",
